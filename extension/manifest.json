{
  "manifest_version": 3,
  "name": "分享到备忘录 (Share to Notes)",
  "version": "1.0.0",
  "description": "把当前网页或链接分享到 macOS 备忘录，效果与 Safari 分享一致（带网页预览卡片）。",
  "key": "",
  "permissions": ["nativeMessaging", "contextMenus", "activeTab"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "分享到备忘录",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+N", "mac": "Alt+Shift+N" },
      "description": "分享当前网页到备忘录"
    }
  }
}
